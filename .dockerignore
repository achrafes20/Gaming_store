# Applies repo-wide: docker-compose.yml builds every service with context "."
# (needed so Dockerfiles can COPY docker/nginx/*.conf — a per-service
# .dockerignore would not see that file at all).
**/vendor
**/node_modules
**/.env
**/.env.*
!**/.env.example
**/database/*.sqlite
**/storage/logs/*
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/bootstrap/cache/*.php
**/tests
.git
.github
IBM DevOps
