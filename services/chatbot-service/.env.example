APP_NAME=chatbot-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8085

# Shared across all Gaming Store microservices — must be identical everywhere.
JWT_SECRET=

CATALOG_SERVICE_URL=http://catalog-service
ORDERS_SERVICE_URL=http://orders-service
USERS_SERVICE_URL=http://users-service
JAEGER_OTLP_URL=http://jaeger:4318

# Google AI Studio key — https://aistudio.google.com/apikey (free tier).
# Can't be auto-generated like JWT_SECRET, so this stays blank until you
# paste your own — see docs/chatbot.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# "single" (JSON) + "file" session/cache: this service has no database of
# its own — see catalog-service's config/logging.php and web-bff's
# .env.example for why "database"/"stderr" would be the wrong choice here.
LOG_CHANNEL=single
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
